# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Required: DeepSeek API key for sentiment analysis + recommendations
DEEPSEEK_API_KEY=

# Required: override the default Flask secret (the default is fine for local dev only)
SECRET_KEY=

# Required: override the JWT signing key
JWT_SECRET_KEY=

# Database (MySQL is the default in backend/config.py; switch to sqlite for quick starts by uncommenting)
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://USER:PASSWORD@localhost:3306/belarus_tourism?charset=utf8mb4

# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Required: DeepSeek API key for sentiment analysis + recommendations
DEEPSEEK_API_KEY=

# Required: override the default Flask secret (the default is fine for local dev only)
SECRET_KEY=

# Required: override the JWT signing key
JWT_SECRET_KEY=

# Optional database override
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:123456@localhost:3306/belarus_tourism?charset=utf8mb4
